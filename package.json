{
  "name": "minimurl",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.0.7",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^3.4.17"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "lint:prettier:check": "prettier -c .",
    "lint:prettier:fix": "prettier -w .",
    "test": "jest",
    "test:watch": "jest --watchAll --runInBand",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "migration:create": "bun sequelize migration:create",
    "migration:up": "bun sequelize db:migrate"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@vercel/speed-insights": "^1.1.0",
    "mysql2": "^3.12.0",
    "next": "^15.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sequelize": "^6.37.5"
  }
}
