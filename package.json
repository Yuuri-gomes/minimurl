{
  "name": "minimurl",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@types/bun": "latest",
    "@types/react": "19.0.7",
    "autoprefixer": "^10.4.20",
    "babel-register": "^6.26.0",
    "commitizen": "4.3.0",
    "concurrently": "^9.1.2",
    "crypto": "^1.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^16.4.7",
    "eslint": "9.19.0",
    "eslint-config-next": "15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "husky": "9.1.4",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^3.4.17"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "dev": "bun run services:up && bun run services:wait:database && bun run migrations:up && next dev",
    "lint:prettier:check": "prettier -c .",
    "lint:prettier:fix": "prettier -w .",
    "lint:eslint:check": "next lint --no-cache --dir .",
    "test": "bun run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"bun run jest --runInBand --verbose\"",
    "test:watch": "jest --watchAll --runInBand",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-mysql.js",
    "migration:create": "bun run sequelize-cli migration:generate --name ",
    "migrations:up": "bun run infra/config/umzug/migrator.js up",
    "migrations:down": "bun run infra/config/umzug/migrator.js down",
    "vercel-build": "next build && bun run migrations:up",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sequelize/core": "^7.0.0-alpha.44",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "ajv": "^8",
    "async-retry": "^1.3.3",
    "eslint-plugin-jest": "^28.11.0",
    "mysql2": "^3.12.0",
    "next": "^15.1.5",
    "next-connect": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sequelize": "^6.37.5",
    "sweetalert2": "^11.15.10",
    "umzug": "^3.8.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
