{
  "name": "minimurl",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.0.7",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^3.4.17"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "dev": "bun run services:up && bun run services:wait:database && bun run migrations:up && next dev",
    "lint:prettier:check": "prettier -c .",
    "lint:prettier:fix": "prettier -w .",
    "test": "bun run services:up && bun run services:wait:database && concurrently -n next,jest --hide next -k -s command-jest 'next dev' 'jest --runInBand'",
    "test:watch": "jest --watchAll --runInBand",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-mysql.js",
    "migration:create": "bun sequelize migration:create",
    "migrations:up": "bun sequelize db:migrate"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@vercel/speed-insights": "^1.1.0",
    "async-retry": "^1.3.3",
    "mysql2": "^3.12.0",
    "next": "^15.1.5",
    "next-connect": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sequelize": "^6.37.5",
    "umzug": "^3.8.2"
  }
}
